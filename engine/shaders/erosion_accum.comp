// Fluvial routing + erosion balance (relaxed in place, uInner Jacobi sweeps per tile):
// gathers drainage area A and sediment flux Qs from upslope neighbours along the
// multiple-flow-direction weights (s_k / s_max)^p / n of the fill surface W (p grows with the
// drainage area of the donor: dispersive on hillslopes, convergent in channels), then
// evaluates the stream-power erosion / xi-q deposition balance of the cell:
//     E = K * A^m * S^n            (detachment; loose material uKloose times easier)
//     D = G * Qs_in / A            (deposition, Davy & Lague 2009)
//     protected lakes (W > h and a deposition cap < 1e4): settle part of the incoming load,
//     up to the cap; other pits pass their load on along the fill surface (no sinks)
// Stores (A_out [m2], Qs_out [m3/step]) and net = E - D [m/step, + = removal].
// With FLOW_ONLY defined: drainage area only (r32f image).
#include "erosion_common.glsl"
layout(binding = 0) uniform sampler2D texH;   // rg = bedrock, loose
layout(binding = 1) uniform sampler2D texW;   // fill surface
layout(binding = 2) uniform sampler2D texM;   // r = erodibility, g = route cap, b = deposition cap, a = hardness
#ifdef FLOW_ONLY
layout(binding = 0, r32f) uniform coherent image2D imgAcc;
#else
layout(binding = 0, rg32f) uniform coherent image2D imgAcc;
layout(binding = 1, r32f) uniform writeonly image2D imgNet;
#endif
uniform float uP;        // MFD exponent for large drainage areas (1.1 on hillslopes)
uniform float uK;        // stream power coefficient
uniform float uMexp;     // area exponent m
uniform float uNexp;     // slope exponent n
uniform float uG;        // deposition coefficient
uniform float uKloose;   // erodibility multiplier of loose material
uniform float uMaxDep;   // max deposition per step (m)
uniform float uMaxEro;   // max erosion per step (m)
uniform float uHardK;    // erodibility scales with hardness^-uHardK
uniform int uInner;
uniform float uLakeTrap; // fraction of the incoming load settling per lake cell and step
uniform float uPitTrap;  // same for unprotected pits (closed depressions of the fill surface)

#define S2 (TS + 4)
#define S1 (TS + 2)
shared float sW[S2 * S2];
shared float sN[S1 * S1];
shared float sX[S1 * S1];
shared float sA[S1 * S1];
shared float sE[S1 * S1];   // MFD exponent of the cell
#ifndef FLOW_ONLY
shared float sQ[S1 * S1];
shared float sH[S1 * S1];
#endif

void main() {
    ivec2 o2 = tileOrigin(2);
    for (int i = int(gl_LocalInvocationIndex); i < S2 * S2; i += TS * TS) {
        ivec2 q = o2 + ivec2(i % S2, i / S2);
        sW[i] = inb(q) ? texelFetch(texW, q, 0).x : 1e9;
    }
    barrier();
    ivec2 o1 = o2 + 1;
    for (int i = int(gl_LocalInvocationIndex); i < S1 * S1; i += TS * TS) {
        ivec2 lq = ivec2(i % S1, i / S1);
        ivec2 q = o1 + lq;
        int j2 = (lq.y + 1) * S2 + lq.x + 1;
        float n = 0.0, smax = 0.0;
        vec4 a = inb(q) ? imageLoad(imgAcc, q) : vec4(0.0);
        float pe = mix(1.1, uP, smoothstep(1e4, 1e6, a.x));
        if (inb(q) && !onBorder(q)) {
            float w0 = sW[j2];
            for (int k = 0; k < 8; k++)
                smax = max(smax, (w0 - sW[j2 + OFF[k].y * S2 + OFF[k].x]) / DST[k]);
            if (smax > 0.0)
                for (int k = 0; k < 8; k++) {
                    float s = (w0 - sW[j2 + OFF[k].y * S2 + OFF[k].x]) / DST[k];
                    if (s > 0.0) n += pow(s / smax, pe);
                }
        }
        sN[i] = n;
        sX[i] = smax;
        sE[i] = pe;
        sA[i] = a.x;
#ifndef FLOW_ONLY
        sQ[i] = a.y;
        sH[i] = inb(q) ? Htot(texH, q) : 1e9;
#endif
    }
    barrier();

    ivec2 l1 = ivec2(gl_LocalInvocationID.xy) + 1;
    int i1 = l1.y * S1 + l1.x;
    int i2 = (l1.y + 1) * S2 + l1.x + 1;
    ivec2 p = o1 + l1;
    bool ok = inb(p);
    float w0 = sW[i2];
    float f[8];
    for (int k = 0; k < 8; k++) {
        f[k] = 0.0;
        ivec2 q = p + OFF[k];
        if (!inb(q) || onBorder(q)) continue;
        int j1 = i1 + OFF[k].y * S1 + OFF[k].x;
        float wq = sW[i2 + OFF[k].y * S2 + OFF[k].x];
        if (wq > w0 && sN[j1] > 0.0 && sX[j1] > 0.0)
            f[k] = pow(((wq - w0) / DST[k]) / sX[j1], sE[j1]) / sN[j1];
    }
    float area = uCell * uCell;
    float Amax = area * float(uRes.x) * float(uRes.y);   // the whole domain (guards against routing cycles)

#ifdef FLOW_ONLY
    float A = sA[i1];
    for (int it = 0; it < uInner; it++) {
        float Ain = 0.0;
        for (int k = 0; k < 8; k++) Ain += f[k] * sA[i1 + OFF[k].y * S1 + OFF[k].x];
        A = min(Ain + area, Amax);
        barrier();
        sA[i1] = A;
        barrier();
    }
    if (ok) imageStore(imgAcc, p, vec4(A));
#else
    float h = sH[i1];
    float S = 0.0, hmin = h, hup = -1e9;
    for (int k = 0; k < 8; k++) {
        float hq = sH[i1 + OFF[k].y * S1 + OFF[k].x];
        if (hq > 1e8) continue;
        S = max(S, (h - hq) / (uCell * DST[k]));
        hmin = min(hmin, hq);
        if (f[k] > 0.0) hup = max(hup, hq);
    }
    vec4 M = ok ? texelFetch(texM, p, 0) : vec4(0.0, 1e9, 1e9, 1.0);
    float hs = ok ? texelFetch(texH, p, 0).y : 0.0;
    bool lake = w0 > h + 0.05;
    float kk = (lake || !ok || onBorder(p)) ? 0.0 : uK * M.r * mix(pow(M.a, -uHardK), uKloose, smoothstep(0.0, 1.0, hs));
    float Elim = min(0.5 * max(h - hmin, 0.0), uMaxEro);
    float Sn = pow(max(S, 0.0), uNexp);
    float A = sA[i1], Qout = sQ[i1], net = 0.0;
    for (int it = 0; it < uInner; it++) {
        float Ain = 0.0, Qin = 0.0;
        for (int k = 0; k < 8; k++) {
            int j1 = i1 + OFF[k].y * S1 + OFF[k].x;
            Ain += f[k] * sA[j1];
            Qin += f[k] * sQ[j1];
        }
        A = min(Ain + area, Amax);
        float E = min(kk * pow(A, uMexp) * Sn, Elim);
        float D;
        // protected lake / tarn: settle part of the load up to the bed cap; other pits trap
        // part of their load (they fill up towards the spill level: no persistent dry pits;
        // anchoring is uplift-only, so there is no deposit-and-sink loop)
        if (lake) D = M.b < 1e4 ? min(uLakeTrap * Qin / area, min(w0, M.b) - h) : min(uPitTrap * Qin / area, w0 - h);
        else D = min(uG * Qin / A, min(Qin / area, 0.5 * (hup - h)));
        D = clamp(D, 0.0, uMaxDep);
        D = min(D, max(M.b - h, 0.0));
        net = E - D;
        Qout = max(Qin + net * area, 0.0);
        barrier();
        sA[i1] = A;
        sQ[i1] = Qout;
        barrier();
    }
    if (ok) {
        imageStore(imgAcc, p, vec4(A, Qout, 0.0, 0.0));
        imageStore(imgNet, p, vec4(net));
    }
#endif
}
