#version 450
// P0 spike A: deterministic fill pattern (must match spike/p0_ref.py and p0_b exactly).
layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer FillBuf { float data[]; };
layout(constant_id = 0) const uint COUNT = 1024u;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < COUNT) {
        data[i] = float((i * i) % 997u);
    }
}
